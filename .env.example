# Copy this file to .env and fill in the values. Never commit .env.
# CI reads the same names from GitHub: Settings > Secrets and variables >
# Actions > Repository secrets.

# Airtable API Configuration
#
# AIRTABLE_API_KEY: an Airtable personal access token (starts with "pat").
#   1. Sign in to Airtable and open https://airtable.com/create/tokens
#   2. Create new token, then add these scopes:
#        data.records:read   (read records; used by the pipeline)
#        schema.bases:read   (list tables and fields; used by list_tables.py)
#   3. Under Access, add only the Open Oakland volunteer base
#   4. Copy the token when it is shown; Airtable won't show it again
#   If you can't see the base, ask a base owner to share it with you first.
#
# AIRTABLE_BASE_ID: the base ID (starts with "app").
#   Open the base in your browser; it is the first path segment of the URL:
#   https://airtable.com/appXXXXXXXXXXXXXX/tblYYYYYYYYYYYYYY/...
#   Table IDs (tbl...) live in dlt/airtable_pipeline/airtable_tables.json.
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_airtable_base_id_here

# PII pseudonymization key (required)
# Emails are stored as a keyed HMAC of this key, and names as fake names derived
# from it. Changing the key changes every hash, so it requires a full reload.
# Use the same key as CI if you want hashes to match. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
PII_HASH_KEY=your_pii_hash_key_here

# DuckDB Database Path
# Set this to change where the DuckDB database file is stored.
# - Leave blank or comment out to use the default location: artifacts/openoakland.duckdb
# - Use relative paths (relative to project root) or absolute paths
# Examples:
#   DUCKDB_PATH=artifacts/openoakland.duckdb
#   DUCKDB_PATH=/var/data/openoakland.duckdb
#   DUCKDB_PATH=/mnt/shared-storage/openoakland.duckdb
DUCKDB_PATH=artifacts/openoakland.duckdb
