# Airtable API Configuration
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_airtable_base_id_here

# PII pseudonymization key (required)
# Emails are stored as a keyed HMAC of this key, and names as fake names derived
# from it. Changing the key changes every hash, so it requires a full reload.
# Use the same key as CI if you want hashes to match. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
PII_HASH_KEY=your_pii_hash_key_here

# DuckDB Database Path
# Set this to change where the DuckDB database file is stored.
# - Leave blank or comment out to use the default location: artifacts/openoakland.duckdb
# - Use relative paths (relative to project root) or absolute paths
# Examples:
#   DUCKDB_PATH=artifacts/openoakland.duckdb
#   DUCKDB_PATH=/var/data/openoakland.duckdb
#   DUCKDB_PATH=/mnt/shared-storage/openoakland.duckdb
DUCKDB_PATH=artifacts/openoakland.duckdb
