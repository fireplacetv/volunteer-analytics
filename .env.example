# Airtable API Configuration
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_airtable_base_id_here

# DuckDB Database Path
# Set this to change where the DuckDB database file is stored.
# - Leave blank or comment out to use the default location: dlt/airtable_pipeline/volunteer_data.duckdb
# - Use relative paths (relative to project root) or absolute paths
# Examples:
#   DUCKDB_PATH=dlt/airtable_pipeline/volunteer_data.duckdb
#   DUCKDB_PATH=/var/data/volunteer_data.duckdb
#   DUCKDB_PATH=/mnt/shared-storage/volunteer_data.duckdb
DUCKDB_PATH=dlt/airtable_pipeline/volunteer_data.duckdb
